get all Jobs  GET
http://localhost:8000/api/v1/user/job/alljobs?page&limit&search&category&subcategory&JobType&WorkMode
export type JobType =
  | "FULL_TIME"
  | "PART_TIME"
  | "CONTRACT"
  | "INTERNSHIP"
  | "FREELANCE";

export type WorkMode =
  | "ONSITE"
  | "REMOTE"
  | "HYBRID";




